# ──────────────────────────────────────────────────────────────────────
#  REQUIRED — OpenRouter API key
# ──────────────────────────────────────────────────────────────────────
# Get one at https://openrouter.ai. Every product LLM call goes through
# OpenRouter — generation (DeepSeek V4 Pro / Llama 4 Maverick / Mistral
# Large 3) and research (Perplexity Sonar Pro). On Railway, set this as a
# Service Variable on BOTH the API service AND the Worker service.
OPENROUTER_API_KEY=sk-or-v1-...

# ──────────────────────────────────────────────────────────────────────
#  LLM configuration
# ──────────────────────────────────────────────────────────────────────
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_DEFAULT_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_RESEARCH_MODEL=perplexity/sonar-pro

# Three slots for the parallel-variation pipeline. Each must be on
# OpenRouter. Defaults are all open-weight; override per environment.
VARIATION_A_MODEL=deepseek/deepseek-v4-pro
VARIATION_A_LABEL=DeepSeek V4 Pro
VARIATION_B_MODEL=meta-llama/llama-4-maverick
VARIATION_B_LABEL=Llama 4 Maverick
VARIATION_C_MODEL=mistralai/mistral-large-2512
VARIATION_C_LABEL=Mistral Large 3

# Eval-harness only — used as an external benchmark, never in the product
# path. Leave empty if you don't run `python -m app.eval_cli`.
ANTHROPIC_API_KEY=

# ──────────────────────────────────────────────────────────────────────
#  Storage  (Railway auto-injects via Postgres + Redis plugins)
# ──────────────────────────────────────────────────────────────────────
# On Railway: leave blank, use plugin variable references in the dashboard:
#   DATABASE_URL=${{Postgres.DATABASE_URL}}
#   REDIS_URL=${{Redis.REDIS_URL}}
# Note: SQLAlchemy needs the asyncpg dialect. If Railway gives you a
# `postgres://` or `postgresql://` URL, transform it to
# `postgresql+asyncpg://` in your env var.
DATABASE_URL=postgresql+asyncpg://personalizer:personalizer@localhost:5433/personalizer
REDIS_URL=redis://localhost:6380/0

# ──────────────────────────────────────────────────────────────────────
#  Clerk (user-facing auth)
# ──────────────────────────────────────────────────────────────────────
# All user sign-in / sign-up / password / 2FA lives in Clerk. The backend
# only verifies session JWTs against Clerk's JWKS endpoint.
#
# Get these from your Clerk dashboard (https://dashboard.clerk.com).
# CLERK_ISSUER is the application's Frontend API URL — find it under
# "API Keys → Show JWT public key" and copy the issuer host (drop /jwks):
#   https://touched-pelican-12.clerk.accounts.dev
# Pinning it is strongly recommended in production: without it, the
# backend would accept tokens signed by ANY Clerk app — which means
# anyone with their own Clerk pk_/sk_ could mint a valid user. The pin
# closes that.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_ISSUER=https://<your-app>.clerk.accounts.dev

# ──────────────────────────────────────────────────────────────────────
#  Lead-magnet tokens (HMAC, NOT user auth)
# ──────────────────────────────────────────────────────────────────────
# Used to rate-limit anonymous visitors who supply an email to the public
# lead magnet. Nothing sensitive lives in these tokens — they only carry
# a brand slug and a lead UUID. Still, generate a real value:
# `openssl rand -hex 32`
LEAD_TOKEN_SECRET=change-me-to-a-long-random-string
LEAD_TOKEN_TTL_HOURS=24

# ──────────────────────────────────────────────────────────────────────
#  App
# ──────────────────────────────────────────────────────────────────────
# Public-facing URLs.
# APP_BASE_URL       — what the backend tells webhooks, etc.
# FRONTEND_BASE_URL  — origin(s) allowed by CORS. Comma-separated. Railway
#                      pattern: "https://<frontend>.up.railway.app,https://personalize.<brand>.com"
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# ──────────────────────────────────────────────────────────────────────
#  Rate limits
# ──────────────────────────────────────────────────────────────────────
RATE_LIMIT_ANON_PER_DAY=1
RATE_LIMIT_LEAD_PER_DAY=20

# ──────────────────────────────────────────────────────────────────────
#  Brand resolution
# ──────────────────────────────────────────────────────────────────────
DEFAULT_BRAND=lakeb2b
BRANDS_DIR=data/brands

# Set to a brand slug ("lakeb2b", "span-global", etc.) to lock this deploy
# to a single brand. Backend ignores Host / query / X-Brand and always
# serves that brand. The brand-specific git branches set this.
LOCKED_BRAND=

# ──────────────────────────────────────────────────────────────────────
#  Transactional email (Resend) — optional
# ──────────────────────────────────────────────────────────────────────
# Clerk handles all auth-related email (verification, password reset).
# Resend is kept configured for future product-level transactional flows
# (e.g. "your batch finished"). Leave empty if you don't need them yet.
RESEND_API_KEY=
RESEND_BASE_URL=https://api.resend.com
RESEND_FROM=Champ Personalize <noreply@championsmail.com>

# ──────────────────────────────────────────────────────────────────────
#  Frontend-only build-time var (Railway: Frontend service variable)
# ──────────────────────────────────────────────────────────────────────
# Absolute URL of the backend API. Baked into the JS bundle at
# `npm run build` time, so set BEFORE the frontend deploys.
# Leave empty for same-origin (compose-dev with Vite proxy, or reverse-proxy).
# Example: VITE_API_BASE_URL=https://api-personalize-lakeb2b.up.railway.app
#
# ⚠  Railway gotcha: the Frontend service must expose this both as a
#    BUILD-time variable (so Vite inlines it) AND a service variable.
#    The Dockerfile declares `ARG VITE_API_BASE_URL`, which Railway only
#    forwards when the var is set at build time. If sign-in shows
#    "Failed to fetch" on the live URL, this is almost always the cause.
VITE_API_BASE_URL=
