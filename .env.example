# --- LLM ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_RESEARCH_MODEL=perplexity/sonar-pro

# Direct Anthropic — used ONLY by the eval harness for the gold baseline.
# Leave empty if you don't run evals; everything else routes through OpenRouter.
ANTHROPIC_API_KEY=

# --- Storage ---
DATABASE_URL=postgresql+asyncpg://personalizer:personalizer@localhost:5432/personalizer
REDIS_URL=redis://localhost:6379/0

# --- App ---
JWT_SECRET=change-me-to-a-long-random-string
APP_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=http://localhost:5173

# --- Rate limits ---
RATE_LIMIT_ANON_PER_DAY=1
RATE_LIMIT_LEAD_PER_DAY=20

# --- Brand resolution ---
DEFAULT_BRAND=lakeb2b
BRANDS_DIR=data/brands

# Set to a brand slug (e.g. "lakeb2b", "span-global") to lock this deploy to a
# single brand. The backend will ignore Host/query/X-Brand resolution and the
# frontend will hard-default to that brand's lead-magnet. Leave empty for the
# multi-brand main branch.
LOCKED_BRAND=
