# ──────────────────────────────────────────────────────────────────────
#  Frontend environment (Vite — read at BUILD time, baked into the bundle)
# ──────────────────────────────────────────────────────────────────────
# Copy to .env.local for local dev. Both files are gitignored.
# In production (Railway), set every VITE_ variable as a BUILD variable
# on the frontend service — they're inlined into the bundle, so a value
# set only at runtime never reaches the browser.

# Clerk publishable key — REQUIRED.
# From https://dashboard.clerk.com → API Keys.
# This is safe to ship to the browser; it's the secret key (sk_*) that
# must stay on the backend only.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# Absolute URL of the backend API. Leave empty for same-origin (Vite dev
# proxy and reverse-proxy production deploys). Set explicitly when the
# backend is on a different origin, e.g. Railway separate services:
#   VITE_API_BASE_URL=https://api-personalize-lakeb2b.up.railway.app
VITE_API_BASE_URL=
